# Normalise line endings for text, so a Windows checkout does not fail the format
# check or change a hash.
* text=auto eol=lf

# Raw email fixtures are byte-exact. RFC 5322 specifies CRLF between header lines,
# so normalising these would change what the tests assert.
tests/fixtures/*.eml -text

# The shell hook must keep LF endings or bash cannot run it on a Windows checkout.
.githooks/pre-commit text eol=lf

# Generated and noisy, so GitHub collapses it by default and keeps it out of the
# language bar. The diff itself stays readable on purpose: a dependency bump is
# reviewed by reading exactly which versions moved, and `-diff` would hide that.
uv.lock linguist-generated=true
