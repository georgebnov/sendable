#!/usr/bin/env bash
# The gate, run at commit time. Enable once per clone with:
#   git config core.hooksPath .githooks
#
# This runs exactly what `just check` and CI run. A failing layer blocks the
# commit. There is also a .pre-commit-config.yaml for the pre-commit framework,
# which runs the same checks; use whichever you prefer, not both.
#
# Emergency bypass: git commit --no-verify. A red check is an unfinished task,
# not a thing to skip past.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v uv >/dev/null 2>&1; then
    echo "uv is not installed, so the gate cannot run. See https://docs.astral.sh/uv/" >&2
    exit 1
fi

# Only run when something Python, or the config that governs it, changed.
staged="$(git diff --cached --name-only --diff-filter=ACM)"
if ! grep -qE '\.(py|toml)$|^justfile$|^\.github/workflows/' <<< "$staged"; then
    exit 0
fi
# production/ is the SaaS pending removal and is excluded from every gate.
if ! grep -vE '^production/' <<< "$staged" | grep -qE '\.(py|toml)$|^justfile$|^\.github/'; then
    exit 0
fi

fail=0
echo "> ruff check"
uv run --quiet ruff check . || fail=1
echo "> ruff format --check"
uv run --quiet ruff format --check . || fail=1
echo "> mypy"
uv run --quiet mypy || fail=1
echo "> pytest with the coverage floor"
uv run --quiet pytest -q --cov --cov-fail-under=69 || fail=1

if [ "$fail" -ne 0 ]; then
    echo "x gate failed. Fix the errors above; do not suppress them." >&2
    echo "  Emergency bypass: git commit --no-verify" >&2
    exit 1
fi
